# Kelana Ria optional runtime configuration
# Copy this file to .env and fill in any provider keys you want to enable.
# Leave any key blank to use built-in local/offline fallbacks.

# Server binding (defaults: 127.0.0.1:8787)
# HOST=0.0.0.0
# PORT=8787
# SOLO_SECURE_COOKIE=1

# Geoapify — live Jakarta street vector maps and walking routes (free tier: 3,000 credits/day)
GEOAPIFY_API_KEY=

# Cloudflare Workers AI — live AI-generated Solo editions (free tier: 10,000 neurons/day)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Midtrans Sandbox — optional test checkout pages for Creator Packs (starts with SB-Mid-server-)
MIDTRANS_SERVER_KEY=

# Optional. Set a private reviewer key on the API server to enable Rulebook editorial review.
RULEBOOK_REVIEWER_KEY=

# Development / QA only — set to 1 to show simulated GPS check-in buttons in production builds
# Leave unset or 0 for real players.
# ALLOW_SIMULATED_LOCATION=1
