{
  "name": "kelana-ria",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.9.0",
  "engines": {
    "node": "24.x",
    "npm": "11.x"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "tsc --build && npm run bundle --workspace @kelana-ria/web",
    "clean": "tsc --build --clean",
    "dev": "npm run dev --workspace @kelana-ria/web",
    "start": "SERVE_WEB=1 npm start --workspace @kelana-ria/api"
  },
  "devDependencies": {
    "typescript": "7.0.2"
  }
}
